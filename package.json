{
  "name": "verso",
  "version": "0.1.3",
  "description": "Word-by-word synced lyrics overlay for Ubuntu and Windows. Free, private, original.",
  "main": "src/main.js",
  "license": "MIT",
  "author": {
    "name": "Federico Taranu",
    "email": "federicotaar@users.noreply.github.com"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node test/parse.test.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "now-playing-media": "^0.2.0"
  },
  "build": {
    "appId": "site.federicotaranu.verso",
    "productName": "Verso",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
